# --- Credentials (required for providers that use an API key) ---
# Either set the key directly...
API_WRAPPER_KEY=replace-me
# ...or point to a mounted secret file instead (Docker secrets):
# API_WRAPPER_KEY_FILE=/run/secrets/api_wrapper_key

# --- Plugging in your detector API (pick one) ---
# Path to a JSON provider config mounted into the container:
DETECTOR_CONFIG_PATH=/config/providers.json
# Or the same JSON inline:
# DETECTOR_CONFIG_JSON={"providers":[...]}

# Comma-separated Python modules that register custom adapters (optional):
# DETECTOR_ADAPTER_MODULES=my_company.detector_adapter

# Provider to use when several are configured (optional):
# DETECTOR_PROVIDER=acme

# --- Tuning (all optional, defaults shown) ---
# DETECTOR_TIMEOUT_SECONDS=20
# DETECTOR_CACHE_TTL_SECONDS=300
# DETECTOR_RATE_LIMIT_PER_SECOND=5
# DETECTOR_ID_MAX_LENGTH=128
# DETECTOR_ID_PATTERN=^[A-Za-z0-9_\-]+$
